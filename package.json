{
  "name": "adminator-admin-dashboard",
  "version": "4.4.0",
  "private": false,
  "description": "Adminator 2026 — vanilla-JS admin dashboard with a token-driven design system, dark mode, Chart.js, FullCalendar, and jsvectormap. No jQuery, no Bootstrap.",
  "main": "dist/index.html",
  "keywords": [
    "admin",
    "dashboard",
    "template",
    "vanilla-js",
    "dark-mode",
    "design-system",
    "css-variables",
    "responsive",
    "mobile-first",
    "scss",
    "webpack",
    "modern",
    "ui-kit",
    "admin-panel",
    "charts",
    "fullcalendar",
    "chartjs"
  ],
  "author": "Aigars Silkalns <hello@colorlib.com> (https://colorlib.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puikinsh/Adminator-admin-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/puikinsh/Adminator-admin-dashboard/issues"
  },
  "homepage": "https://adminator.colorlib.com/",
  "files": [
    "dist/**/*",
    "src/**/*",
    "webpack.config.js",
    "webpack/**/*",
    "CLAUDE.md",
    "CHANGELOG.md",
    "README.md",
    "scripts/clean.mjs",
    "scripts/preview.mjs",
    "scripts/verify-build.mjs"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "start": "webpack server",
    "dev": "npm start",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && cross-env NODE_ENV=production MINIFY=false webpack && npm run verify:build",
    "build:analyze": "npm run clean && cross-env ANALYZE=true NODE_ENV=production MINIFY=true webpack",
    "release:minified": "npm run clean && cross-env NODE_ENV=production MINIFY=true webpack && npm run verify:build -- --budget",
    "release:unminified": "npm run build",
    "preview": "node scripts/preview.mjs",
    "lint:js": "eslint src/assets/scripts webpack tests eslint.config.mjs vitest.config.mjs webpack.config.js scripts/clean.mjs scripts/preview.mjs scripts/browser-smoke.mjs scripts/verify-build.mjs scripts/release-notes.mjs",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "lint": "npm run lint:js && npm run lint:scss",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "screenshots": "node scripts/screenshots.mjs",
    "prepublishOnly": "npm run check",
    "postpublish": "echo 'Package published successfully! View at: https://www.npmjs.com/package/adminator-admin-dashboard'",
    "check": "npm run lint && npm run test:run && npm run release:minified",
    "test:browser": "node scripts/browser-smoke.mjs",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.4",
    "case-sensitive-paths-webpack-plugin": "^2.4.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^30.1.2",
    "mini-css-extract-plugin": "^2.10.2",
    "playwright": "^1.64.0",
    "postcss": "^8.5.30",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.6.1",
    "sass": "^1.105.1",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "vitest": "^5.0.4",
    "webpack": "^5.111.1",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "fullcalendar": "^7.1.2",
    "jsvectormap": "^1.7.0"
  }
}
